# cook your dish here
def can_tomu_win(N, K, A):
    motu = [A[i] for i in range(0, N, 2)]
    tomu = [A[i] for i in range(1, N, 2)]
    motu_sum = sum(motu)
    tomu_sum = sum(tomu)
    if tomu_sum > motu_sum:
        return "YES"
    motu.sort(reverse=True)
    tomu.sort()
    swaps = min(K, min(len(motu), len(tomu)))
    for i in range(swaps):
        if motu[i] > tomu[i]:
            motu_sum -= motu[i]
            motu_sum += tomu[i]
            tomu_sum -= tomu[i]
            tomu_sum += motu[i]
        else:
            break  
        if tomu_sum > motu_sum:
            return "YES"
    return "NO"
T = int(input().strip())
for _ in range(T):
    N, K = map(int, input().split())
    A = list(map(int, input().split()))
    print(can_tomu_win(N, K, A))
